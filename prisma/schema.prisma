// Genesyz Prisma Schema
// AI-powered idea vault for founders

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===========================================
// Authentication (Better Auth)
// ===========================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  username      String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Email Verification
  verificationCode   String?
  verificationExpiry DateTime?
  accountStatus      AccountStatus @default(ACTIVE)

  // Password Reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // Preferences
  emailNotifications  Boolean @default(true)
  onboardingDismissed Boolean @default(false)
  location            String?
  locationContext     Json?

  role             UserRole @default(USER)
  twoFactorEnabled Boolean  @default(false)

  // Relations
  sessions           Session[]
  accounts           Account[]
  ideas              Idea[]
  entitlements       Entitlement[]
  auditLogs          AuditLog[]
  startups           Startup[]
  accelerators       Accelerator[]
  startupMembers     StartupMember[]
  acceleratorMembers AcceleratorMember[]
  members            Member[]
  invitations        Invitation[]
  twoFactor          TwoFactor?

  // School / LMS
  enrollments        Enrollment[]
  quizAttempts       QuizAttempt[]
  submissions        Submission[]
  certificates       Certificate[]
  userBadges         UserBadge[]
  streak             Streak?
  learningActivities LearningActivity[]
  courseAssignments  CourseAssignment[]
  usageEvents        WorkspaceUsageEvent[]
  uploadedFiles      WorkspaceFile[]

  // Tasks
  taskAssignees TaskAssignee[]

  @@map("users")
}

// ===========================================
// Two Factor Auth (Better Auth plugin)
// ===========================================
model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  userId      String  @unique
  verified    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  FROZEN
  DELETED
}

enum StartupMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===========================================
// Organization (Better Auth plugin)
// ===========================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           Member[]
  invitations       Invitation[]
  startups          Startup[]
  hostedProjects    HostedProject[]
  entitlement       OrganizationEntitlement?
  courseAssignments CourseAssignment[]
  usageEvents       WorkspaceUsageEvent[]
  files             WorkspaceFile[]

  @@map("organization")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String    @default("pending")
  expiresAt      DateTime?
  inviterId      String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invitation")
}

// ===========================================
// Core Business Logic
// ===========================================

model Idea {
  id           String     @id @default(cuid())
  userId       String
  title        String?
  summary      String?
  status       IdeaStatus @default(PENDING)
  isArchived   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  researchedAt DateTime?

  // Sharing
  shareToken String? @unique // For public sharing

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputs          IdeaInput[]
  researchJobs    ResearchJob[]
  researchPackets ResearchPacket[]
  scores          IdeaScore[]
  researchLogs    ResearchLog[]
  snapshots       IdeaSnapshot[]

  // Interrogation State
  founderGoals String[] @default([])
  assumptions  Json? // Array of assumption objects
  metrics      Json? // Quantitative metrics (MAU, CAC, LTV, etc.)
  state        Json? // Full state snapshot for delta detection

  // Location Targeting
  targetLocation  String? // User-specified location (e.g., "United States", "California")
  locationContext Json? // Structured location data: { country, region, city, timezone }

  // URL Handling
  extractedUrls String[]     @default([]) // URLs found in user input
  urlContents   UrlContent[] // Scraped content from URLs

  // Prompt Tracking & Contextualization
  originalPrompt    String?         @db.Text // What user actually submitted
  interpretedPrompt String?         @db.Text // AI's interpretation/enhancement
  promptVersions    PromptVersion[] // Track prompt edits

  // AI Guide
  guideConversations GuideConversation[]

  // Startup Profile
  startup Startup?

  // Research Feed
  researchFeedItems ResearchFeedItem[]
  files             WorkspaceFile[]

  @@index([userId])
  @@index([status])
  @@index([targetLocation])
  @@map("ideas")
}

model IdeaSnapshot {
  id      String   @id @default(cuid())
  ideaId  String
  date    DateTime @default(now())
  state   Json // Full state JSON as per spec
  verdict Json // Verdict JSON (Go/Pause/Kill, etc.)
  deltas  Json? // Detected changes since last snapshot

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_snapshots")
}

enum IdeaStatus {
  PENDING // Just submitted, not yet processed
  PROCESSING // AI pipeline running
  RESEARCHED // Research complete
  FAILED // Pipeline failed
  CONVERTED // Idea was converted into a startup
}

model IdeaInput {
  id       String        @id @default(cuid())
  ideaId   String
  type     IdeaInputType
  content  String? // Text content
  fileUrl  String? // URL to uploaded file
  fileName String?
  mimeType String?
  fileSize Int?

  // Processed content
  transcription String? // For audio inputs
  ocrText       String? // For image inputs

  // URL Handling
  extractedUrls String[] @default([]) // URLs found in this specific input

  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_inputs")
}

enum IdeaInputType {
  TEXT
  AUDIO
  IMAGE
}

// ===========================================
// AI Research Pipeline
// ===========================================

model ResearchJob {
  id           String            @id @default(cuid())
  ideaId       String
  status       ResearchJobStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  error        String?
  retryCount   Int               @default(0)
  inngestRunId String? // Track Inngest run ID
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([status])
  @@map("research_jobs")
}

enum ResearchJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ResearchPacket {
  id         String            @id @default(cuid())
  ideaId     String
  agentType  ResearchAgentType
  content    Json // Structured agent output
  confidence Float? // 0-1 confidence score
  version    Int               @default(1)
  createdAt  DateTime          @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([agentType])
  @@map("research_packets")
}

enum ResearchAgentType {
  INTERPRETER
  MARKET_RESEARCH
  TREND_ANALYSIS
  EXECUTION_FRICTION
  SYNTHESIS
  DEEP_RESEARCH
  STRATEGIC_ADVISORY
}

model IdeaScore {
  id     String @id @default(cuid())
  ideaId String

  // Individual scores (0-100)
  clarityScore   Int?
  marketScore    Int?
  executionScore Int?
  overallScore   Int?

  // Explanations
  clarityExplanation   String?
  marketExplanation    String?
  executionExplanation String?
  overallExplanation   String?

  version   Int      @default(1)
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_scores")
}

model ResearchLog {
  id         String            @id @default(cuid())
  ideaId     String
  agentType  ResearchAgentType
  promptHash String // Hash for deduplication
  prompt     String // Full prompt sent
  response   String // Raw response received
  model      String // AI model used
  tokensUsed Int?
  latencyMs  Int?
  createdAt  DateTime          @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([agentType])
  @@map("research_logs")
}

// ===========================================
// Billing (Polar)
// ===========================================

model Entitlement {
  id                  String            @id @default(cuid())
  userId              String
  polarCustomerId     String?
  polarSubscriptionId String?
  plan                EntitlementPlan   @default(FREE)
  maxActiveIdeas      Int               @default(3)
  status              EntitlementStatus @default(ACTIVE)
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([polarCustomerId])
  @@index([polarSubscriptionId])
  @@map("entitlements")
}

// Organization-owned platform billing. User entitlements remain temporarily
// for backwards compatibility while workspace billing is rolled out.
model OrganizationEntitlement {
  id                  String            @id @default(cuid())
  organizationId      String            @unique
  polarCustomerId     String?
  polarSubscriptionId String?
  plan                WorkspacePlan     @default(EXPLORER)
  status              EntitlementStatus @default(ACTIVE)
  seats               Int               @default(1)
  maxStartups         Int               @default(1)
  aiCredits           Int               @default(100)
  builderCredits      Int               @default(0)
  hostingCredits      Int               @default(0)
  storageBytes        BigInt            @default(0)
  storageLimitBytes   BigInt            @default(262144000)
  hostedProjectLimit  Int               @default(0)
  capabilities        Json              @default("{}")
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([polarCustomerId])
  @@index([polarSubscriptionId])
  @@map("organization_entitlements")
}

model StartupEntitlement {
  id               String        @id @default(cuid())
  startupId        String        @unique
  plan             WorkspacePlan @default(FOUNDER)
  inherited        Boolean       @default(true)
  aiCredits        Int           @default(25)
  builderCredits   Int           @default(0)
  hostingCredits   Int           @default(0)
  featureOverrides Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@map("startup_entitlements")
}

enum EntitlementPlan {
  FREE
  PRO
}

enum WorkspacePlan {
  EXPLORER
  FOUNDER
  TEAM
  GROWTH
  ACCELERATOR
  ENTERPRISE
}

enum EntitlementStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

// ===========================================
// Audit & Security
// ===========================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // e.g., "idea.created", "research.completed"
  resource   String? // e.g., "idea", "research_job"
  resourceId String?
  metadata   Json? // Additional context
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===========================================
// URL Scraping
// ===========================================

model UrlContent {
  id          String           @id @default(cuid())
  ideaId      String
  url         String
  title       String?
  description String?
  content     String           @db.Text // Scraped text content
  metadata    Json? // Headers, timestamps, contentType, etc.
  status      UrlContentStatus @default(PENDING) // PENDING, SCRAPED, FAILED
  error       String? // Error message if scraping failed
  scrapedAt   DateTime? // When scraping completed
  createdAt   DateTime         @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([url])
  @@map("url_contents")
}

enum UrlContentStatus {
  PENDING
  SCRAPED
  FAILED
}

// ===========================================
// Prompt Tracking & Versioning
// ===========================================

model PromptVersion {
  id                String   @id @default(cuid())
  ideaId            String
  prompt            String   @db.Text // The prompt text at this version
  editedAt          DateTime @default(now())
  triggeredResearch Boolean  @default(false) // Whether this edit triggered new research
  editedBy          String? // User ID if available

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([editedAt])
  @@map("prompt_versions")
}

// ===========================================
// AI Guide - Conversational Deep Dive
// ===========================================

model GuideConversation {
  id           String   @id @default(cuid())
  ideaId       String
  title        String? // Optional title for the conversation
  isActive     Boolean  @default(true) // Soft delete support
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages GuideMessage[]
  idea     Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([isActive])
  @@map("guide_conversations")
}

model GuideMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           GuideMessageRole
  content        String           @db.Text
  toolCalls      Json? // Any tool calls made by AI (search, etc.)
  toolResults    Json? // Results from tool calls
  tokensUsed     Int? // Token count for this message
  createdAt      DateTime         @default(now())

  conversation GuideConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("guide_messages")
}

enum GuideMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ===========================================
// Startup Profiles
// ===========================================

model Startup {
  id     String  @id @default(cuid())
  ideaId String? @unique
  userId String

  // Profile Data
  name         String
  slug         String        @unique
  tagline      String?
  description  String?       @db.Text
  industry     String?
  stage        StartupStage  @default(IDEA)
  targetMarket TargetMarket?

  // Branding
  logoUrl         String?
  website         String?
  location        String  @default("")
  locationContext Json?

  // Launch Status
  isLaunched    Boolean   @default(false)
  launchDate    DateTime?
  weeksToLaunch Int?

  // Primary Metric
  primaryMetricType   PrimaryMetricType @default(USER_CONVERSATIONS)
  primaryMetricValue  Float?
  primaryMetricTarget Float?

  // Weekly Tracking
  currentWeekNumber Int       @default(1)
  lastUpdateAt      DateTime?

  // Status
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organizationId String?

  // Relations
  idea                    Idea?                    @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization            Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  entitlement             StartupEntitlement?
  weeklyUpdates           WeeklyUpdate[]
  metrics                 StartupMetric[]
  goals                   StartupGoal[]
  opportunities           StartupOpportunity[]
  cohortStartups          CohortStartup[]
  acceleratorApplications AcceleratorApplication[]
  streak                  StartupStreak?
  taskLists               TaskList[]
  tasks                   Task[]
  taskMilestones          TaskMilestone[]
  growthExperiments       GrowthExperiment[]
  members                 StartupMember[]
  followers               StartupFollower[]
  conversations           StartupConversation[]
  researchFeedItems       ResearchFeedItem[]
  flags                   StartupFlag[]
  mentorMatches           MentorMatch[]
  taskLabels              TaskLabel[]
  customerPersonas        CustomerPersona[]
  growthCampaigns         GrowthCampaign[]
  growthEvents            GrowthEvent[]
  prototypes              Prototype[]
  hostedProjects          HostedProject[]
  usageEvents             WorkspaceUsageEvent[]
  files                   WorkspaceFile[]
  lectureProgresses       LectureProgress[]
  enrollments             Enrollment[]
  certificates            Certificate[]

  @@index([userId])
  @@index([slug])
  @@map("startups")
}

model Prototype {
  id          String    @id @default(cuid())
  startupId   String
  name        String
  prompt      String?   @db.Text
  html        String    @db.Text
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  startup        Startup         @relation(fields: [startupId], references: [id], onDelete: Cascade)
  hostedProject  HostedProject?
  hostedReleases HostedRelease[]

  @@index([startupId, updatedAt])
  @@map("prototypes")
}

model HostedProject {
  id              String   @id @default(cuid())
  organizationId  String
  startupId       String
  prototypeId     String   @unique
  slug            String   @unique
  provider        String   @default("static")
  status          String   @default("ACTIVE")
  activeReleaseId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startup       Startup         @relation(fields: [startupId], references: [id], onDelete: Cascade)
  prototype     Prototype       @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  releases      HostedRelease[]
  route         HostedRoute?
  activeRelease HostedRelease?  @relation("ActiveHostedRelease", fields: [activeReleaseId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([startupId])
  @@map("hosted_projects")
}

model HostedRelease {
  id          String    @id @default(cuid())
  projectId   String
  prototypeId String
  version     Int
  provider    String    @default("static")
  status      String    @default("VALIDATED")
  html        String    @db.Text
  manifest    Json?
  error       String?   @db.Text
  promotedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   HostedProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prototype Prototype            @relation(fields: [prototypeId], references: [id], onDelete: Cascade)
  activeFor HostedProject?       @relation("ActiveHostedRelease")
  events    HostedReleaseEvent[]

  @@unique([projectId, version])
  @@index([projectId, status])
  @@map("hosted_releases")
}

model HostedReleaseEvent {
  id        String   @id @default(cuid())
  releaseId String
  type      String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  release HostedRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, createdAt])
  @@map("hosted_release_events")
}

model HostedRoute {
  id        String   @id @default(cuid())
  projectId String   @unique
  slug      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project HostedProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("hosted_routes")
}

model WorkspaceUsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String
  startupId      String?
  resource       String
  amount         Int
  operationKey   String   @unique
  status         String   @default("COMMITTED")
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  startup      Startup?     @relation(fields: [startupId], references: [id], onDelete: SetNull)

  @@index([organizationId, resource, createdAt])
  @@index([startupId])
  @@map("workspace_usage_events")
}

model WorkspaceFile {
  id             String    @id @default(cuid())
  organizationId String
  uploadedById   String
  startupId      String?
  ideaId         String?
  objectKey      String    @unique
  url            String?
  name           String?
  mimeType       String?
  byteSize       BigInt
  status         String    @default("PENDING")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  startup      Startup?     @relation(fields: [startupId], references: [id], onDelete: SetNull)
  idea         Idea?        @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([startupId])
  @@index([ideaId])
  @@map("workspace_files")
}

model StartupConversation {
  id           String   @id @default(cuid())
  startupId    String
  title        String?
  isActive     Boolean  @default(true)
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages StartupMessage[]
  startup  Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@index([isActive])
  @@map("startup_conversations")
}

model StartupMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user, assistant, system
  content        String   @db.Text
  toolCalls      Json?
  toolResults    Json?
  tokensUsed     Int?
  createdAt      DateTime @default(now())

  conversation StartupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("startup_messages")
}

model StartupFollower {
  id        String   @id @default(cuid())
  startupId String
  email     String
  name      String?
  createdAt DateTime @default(now())
  createdBy String?

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([startupId, email])
  @@index([startupId])
  @@index([email])
  @@map("startup_followers")
}

model StartupMember {
  id        String            @id @default(cuid())
  startupId String
  userId    String
  role      StartupMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([startupId, userId])
  @@index([startupId])
  @@index([userId])
  @@map("startup_members")
}

model WeeklyUpdate {
  id         String   @id @default(cuid())
  startupId  String
  weekNumber Int
  weekStart  DateTime
  weekEnd    DateTime

  // Launch Section
  isLaunched    Boolean @default(false)
  weeksToLaunch Int?

  // User Conversations
  usersTalkedTo Int     @default(0)
  userLearnings String? @db.Text

  // Primary Metric
  primaryMetricType  PrimaryMetricType @default(USER_CONVERSATIONS)
  primaryMetricValue Float
  primaryMetricDelta Float?
  metricPeriod       MetricPeriod?
  metricFormat       MetricFormat?
  customMetricName   String?

  // Additional Metrics (expandable section)
  additionalMetrics Json?

  // Goals Review
  previousGoalsReview Json?
  goalsCompletionRate Float?

  // Goals & Morale
  moraleScore     Int // 1-10
  topImprovements String? @db.Text
  biggestObstacle String? @db.Text

  // AI Coaching
  aiAnalysis        Json?
  aiVerdict         String?
  aiRecommendations Json?

  // Editability
  editableUntil DateTime? // Can be edited until this time (createdAt + 3 days)
  isLocked      Boolean   @default(false)
  lockedAt      DateTime?

  createdAt DateTime @default(now())

  startup       Startup             @relation(fields: [startupId], references: [id], onDelete: Cascade)
  goals         WeeklyGoal[]
  metricHistory WeeklyMetricEntry[]

  @@unique([startupId, weekNumber])
  @@index([startupId])
  @@index([weekStart])
  @@map("weekly_updates")
}

model WeeklyGoal {
  id             String  @id @default(cuid())
  weeklyUpdateId String
  content        String
  priority       Int     @default(1)
  completed      Boolean @default(false)

  weeklyUpdate WeeklyUpdate @relation(fields: [weeklyUpdateId], references: [id], onDelete: Cascade)

  @@index([weeklyUpdateId])
  @@map("weekly_goals")
}

model WeeklyMetricEntry {
  id             String            @id @default(cuid())
  weeklyUpdateId String
  metricType     PrimaryMetricType
