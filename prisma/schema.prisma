}

model StartupGoal {
  id        String    @id @default(cuid())
  startupId String
  content   String
  completed Boolean   @default(false)
  dueDate   DateTime?
  priority  Int       @default(0) // 1=Top Priority, 2=Secondary, 3=Third, 0=Normal
