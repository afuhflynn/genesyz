// ===========================================
// Startup Opportunities
// ===========================================

enum OpportunityCategory {
  FELLOWSHIP
  SCHOLARSHIP
  FUNDING
  COMPETITION
  ACCELERATOR
  GRANT
  MENTORSHIP
  OTHER
}

enum OpportunityStatus {
  DISCOVERED
  BOOKMARKED
  TO_APPLY
  APPLIED
  INTERVIEWING
  ACCEPTED
  REJECTED
}

model StartupOpportunity {
  id          String              @id @default(cuid())
  startupId   String
  title       String
  description String              @db.Text
  url         String
  category    OpportunityCategory
  eligibility String?             @db.Text
  benefits    String?             @db.Text
  deadline    DateTime?

  // Tracking
  status    OpportunityStatus @default(DISCOVERED)
  appliedAt DateTime?
  notes     String?           @db.Text

  // Source
  source String @default("manual") // manual, ai_generated

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@index([status])
  @@index([category])
  @@map("startup_opportunities")
}

// ===========================================
// Accelerator Program
// ===========================================

model Accelerator {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Description
  description String? @db.Text
  programType String  @default("accelerator") // incubator, accelerator, cohort_based

  // Branding
  logoUrl      String?
  website      String?
  contactEmail String?

  // Program Details
  durationWeeks Int?
  benefits      String? @db.Text
  requirements  String? @db.Text
  maxStartups   Int?
  fundingAmount String?

  // Visibility
  isPublic Boolean @default(true)
  isActive Boolean @default(true)

  // Owner (Superior Admin)
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cohorts      Cohort[]
  events       AcceleratorEvent[]
  applications AcceleratorApplication[]
  members      AcceleratorMember[]
  invitations  AcceleratorInvitation[]
  kpis         AcceleratorKPI[]
  reports      AcceleratorWeeklyReport[]
  mentors      Mentor[]

  @@index([slug])
  @@index([ownerId])
  @@index([isPublic])
  @@map("accelerators")
}

enum AcceleratorRole {
  OWNER // Superior Admin: Full access, manage admins
  PROGRAM_MANAGER // Manage cohorts, startups, flags
  OPERATIONS_LEAD // Manage events, curriculum, logistics
  MENTOR // View assigned startups, feedback
  OBSERVER // Read-only
}

model AcceleratorMember {
  id            String          @id @default(cuid())
  acceleratorId String
  userId        String
  role          AcceleratorRole @default(PROGRAM_MANAGER)
  joinedAt      DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accelerator Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([acceleratorId, userId])
  @@index([userId])
  @@map("accelerator_members")
}

model AcceleratorInvitation {
  id            String          @id @default(cuid())
  acceleratorId String
  email         String
  role          AcceleratorRole @default(PROGRAM_MANAGER)
  token         String          @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  invitedById   String
  createdAt     DateTime        @default(now())

  accelerator Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)

  @@index([acceleratorId])
  @@index([email])
  @@map("accelerator_invitations")
}

model AcceleratorKPI {
  id            String    @id @default(cuid())
  acceleratorId String
  name          String
  targetValue   Float
  currentValue  Float     @default(0)
  unit          String? // $, %, count
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accelerator Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)

  @@index([acceleratorId])
  @@map("accelerator_kpis")
}

model AcceleratorWeeklyReport {
  id            String   @id @default(cuid())
  acceleratorId String
  weekNumber    Int
  content       String   @db.Text
  metrics       Json? // Snapshot of aggregate KPIs
  aiSummary     String?  @db.Text
  createdAt     DateTime @default(now())

  accelerator Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)

  @@index([acceleratorId])
  @@map("accelerator_weekly_reports")
}

model StartupFlag {
  id           String    @id @default(cuid())
  startupId    String
  reason       String    @db.Text
  severity     String    @default("warning") // warning, critical
  status       String    @default("active") // active, resolved
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@map("startup_flags")
}

model Mentor {
  id            String   @id @default(cuid())
  acceleratorId String
  userId        String?
  name          String
  email         String
  expertise     String[] // ["legal", "marketing", "technical"]
  bio           String?  @db.Text
  linkedIn      String?
  createdAt     DateTime @default(now())

  accelerator Accelerator   @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)
  matches     MentorMatch[]

  @@index([acceleratorId])
  @@map("mentors")
}

model MentorMatch {
  id        String   @id @default(cuid())
  mentorId  String
  startupId String
  focus     String?
  createdAt DateTime @default(now())

  mentor  Mentor  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([mentorId, startupId])
  @@map("mentor_matches")
}

model Cohort {
  id            String   @id @default(cuid())
  acceleratorId String
  name          String // "Winter 2026"
  description   String?
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)

  accelerator Accelerator        @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)
  startups    CohortStartup[]
  events      AcceleratorEvent[]

  @@index([acceleratorId])
  @@map("cohorts")
}

model CohortStartup {
  cohortId  String
  startupId String
  joinedAt  DateTime @default(now())

  cohort  Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@id([cohortId, startupId])
  @@index([startupId])
  @@map("cohort_startups")
}

model AcceleratorEvent {
  id            String  @id @default(cuid())
  cohortId      String?
  acceleratorId String

  title       String
  description String?  @db.Text
  eventType   String // mentor_session, office_hours, demo_day, workshop, networking
  scheduledAt DateTime
  duration    Int // minutes
  location    String? // physical, virtual, hybrid
  meetingUrl  String?

  cohort      Cohort?           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  accelerator Accelerator       @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)
  attendance  EventAttendance[]

  @@index([acceleratorId])
  @@index([cohortId])
  @@index([scheduledAt])
  @@map("accelerator_events")
}

model EventAttendance {
  eventId   String
  userId    String
  status    String   @default("rsvp") // rsvp, attended, absent
  feedback  String?  @db.Text
  createdAt DateTime @default(now())

  event AcceleratorEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_attendance")
}

model AcceleratorApplication {
  id            String  @id @default(cuid())
  acceleratorId String
  startupId     String?
  founderEmail  String
  founderName   String
  founderPhone  String?

  // Application
  status  String  @default("pending") // pending, accepted, waitlisted, rejected
  notes   String? @db.Text
  answers Json? // Custom application answers

  // Timestamps
  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accelerator Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)
  startup     Startup?    @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([acceleratorId])
  @@index([startupId])
  @@map("accelerator_applications")
