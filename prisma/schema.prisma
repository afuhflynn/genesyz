// IdeasVault Prisma Schema
// AI-powered idea vault for founders

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===========================================
// Authentication (Better Auth)
// ===========================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  username      String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Email Verification
  verificationCode   String?
  verificationExpiry DateTime?
  accountStatus      AccountStatus @default(ACTIVE)

  // Password Reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // Preferences
  emailNotifications Boolean @default(true)

  role UserRole @default(USER)

  // Relations
  sessions     Session[]
  accounts     Account[]
  ideas        Idea[]
  entitlements Entitlement[]
  auditLogs    AuditLog[]
  startups     Startup[]
  accelerators Accelerator[]
  startupMembers StartupMember[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  FROZEN
  DELETED
}

enum StartupMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===========================================
// Core Business Logic
// ===========================================

model Idea {
  id           String     @id @default(cuid())
  userId       String
  title        String?
  summary      String?
  status       IdeaStatus @default(PENDING)
  isArchived   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  researchedAt DateTime?
  
  // Sharing
  shareToken   String?   @unique // For public sharing

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputs          IdeaInput[]
  researchJobs    ResearchJob[]
  researchPackets ResearchPacket[]
  scores          IdeaScore[]
  researchLogs    ResearchLog[]
  snapshots       IdeaSnapshot[]

  // Interrogation State
  founderGoals String[] @default([])
  assumptions  Json? // Array of assumption objects
  metrics      Json? // Quantitative metrics (MAU, CAC, LTV, etc.)
  state        Json? // Full state snapshot for delta detection

  // Location Targeting
  targetLocation  String? // User-specified location (e.g., "United States", "California")
  locationContext Json?   // Structured location data: { country, region, city, timezone }

  // URL Handling
  extractedUrls String[] @default([]) // URLs found in user input
  urlContents   UrlContent[]          // Scraped content from URLs

  // Prompt Tracking & Contextualization
  originalPrompt    String? @db.Text // What user actually submitted
  interpretedPrompt String? @db.Text // AI's interpretation/enhancement
  promptVersions    PromptVersion[]  // Track prompt edits

  // AI Guide
  guideConversations GuideConversation[]

  // Startup Profile
  startup Startup?

  // Research Feed
  researchFeedItems ResearchFeedItem[]

  @@index([userId])
  @@index([status])
  @@index([targetLocation])
  @@map("ideas")
}

model IdeaSnapshot {
  id      String   @id @default(cuid())
  ideaId  String
  date    DateTime @default(now())
  state   Json // Full state JSON as per spec
  verdict Json // Verdict JSON (Go/Pause/Kill, etc.)
  deltas  Json? // Detected changes since last snapshot

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_snapshots")
}

enum IdeaStatus {
  PENDING // Just submitted, not yet processed
  PROCESSING // AI pipeline running
  RESEARCHED // Research complete
  FAILED // Pipeline failed
}

model IdeaInput {
  id       String        @id @default(cuid())
  ideaId   String
  type     IdeaInputType
  content  String? // Text content
  fileUrl  String? // URL to uploaded file
  fileName String?
  mimeType String?
  fileSize Int?

  // Processed content
  transcription String? // For audio inputs
  ocrText       String? // For image inputs

  // URL Handling
  extractedUrls String[] @default([]) // URLs found in this specific input

  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_inputs")
}

enum IdeaInputType {
  TEXT
  AUDIO
  IMAGE
}

// ===========================================
// AI Research Pipeline
// ===========================================

model ResearchJob {
  id           String            @id @default(cuid())
  ideaId       String
  status       ResearchJobStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  error        String?
  retryCount   Int               @default(0)
  inngestRunId String? // Track Inngest run ID
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([status])
  @@map("research_jobs")
}

enum ResearchJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ResearchPacket {
  id         String            @id @default(cuid())
  ideaId     String
  agentType  ResearchAgentType
  content    Json // Structured agent output
  confidence Float? // 0-1 confidence score
  version    Int               @default(1)
  createdAt  DateTime          @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([agentType])
  @@map("research_packets")
}

enum ResearchAgentType {
  INTERPRETER
  MARKET_RESEARCH
  TREND_ANALYSIS
  EXECUTION_FRICTION
  SYNTHESIS
  DEEP_RESEARCH
  STRATEGIC_ADVISORY
}

model IdeaScore {
  id     String @id @default(cuid())
  ideaId String

  // Individual scores (0-100)
  clarityScore   Int?
  marketScore    Int?
  executionScore Int?
  overallScore   Int?

  // Explanations
  clarityExplanation   String?
  marketExplanation    String?
  executionExplanation String?
  overallExplanation   String?

  version   Int      @default(1)
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_scores")
}

model ResearchLog {
  id         String            @id @default(cuid())
  ideaId     String
  agentType  ResearchAgentType
  promptHash String // Hash for deduplication
  prompt     String // Full prompt sent
  response   String // Raw response received
  model      String // AI model used
  tokensUsed Int?
  latencyMs  Int?
  createdAt  DateTime          @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([agentType])
  @@map("research_logs")
}

// ===========================================
// Billing (Polar)
// ===========================================

model Entitlement {
  id                  String            @id @default(cuid())
  userId              String
  polarCustomerId     String?
  polarSubscriptionId String?
  plan                EntitlementPlan   @default(FREE)
  maxActiveIdeas      Int               @default(3)
  status              EntitlementStatus @default(ACTIVE)
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([polarCustomerId])
  @@index([polarSubscriptionId])
  @@map("entitlements")
}

enum EntitlementPlan {
  FREE
  PRO
}

enum EntitlementStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

// ===========================================
// Audit & Security
// ===========================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // e.g., "idea.created", "research.completed"
  resource   String? // e.g., "idea", "research_job"
  resourceId String?
  metadata   Json? // Additional context
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===========================================
// URL Scraping
// ===========================================

model UrlContent {
  id          String   @id @default(cuid())
  ideaId      String
  url         String
  title       String?
  description String?
  content     String   @db.Text // Scraped text content
  metadata    Json?    // Headers, timestamps, contentType, etc.
  status      UrlContentStatus @default(PENDING) // PENDING, SCRAPED, FAILED
  error       String?  // Error message if scraping failed
  scrapedAt   DateTime? // When scraping completed
  createdAt   DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([url])
  @@map("url_contents")
}

enum UrlContentStatus {
  PENDING
  SCRAPED
  FAILED
}

// ===========================================
// Prompt Tracking & Versioning
// ===========================================

model PromptVersion {
  id                String   @id @default(cuid())
  ideaId            String
  prompt            String   @db.Text // The prompt text at this version
  editedAt          DateTime @default(now())
  triggeredResearch Boolean  @default(false) // Whether this edit triggered new research
  editedBy          String?  // User ID if available

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([editedAt])
  @@map("prompt_versions")
}

// ===========================================
// AI Guide - Conversational Deep Dive
// ===========================================

model GuideConversation {
  id        String         @id @default(cuid())
  ideaId    String
  title     String?        // Optional title for the conversation
  isActive  Boolean        @default(true) // Soft delete support
  messageCount Int        @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages GuideMessage[]
  idea     Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([isActive])
  @@map("guide_conversations")
}

model GuideMessage {
  id             String            @id @default(cuid())
  conversationId String
  role           GuideMessageRole
  content        String            @db.Text
  toolCalls      Json?             // Any tool calls made by AI (search, etc.)
  toolResults    Json?             // Results from tool calls
  tokensUsed     Int?              // Token count for this message
  createdAt      DateTime          @default(now())

  conversation GuideConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("guide_messages")
}

enum GuideMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ===========================================
// Startup Profiles
// ===========================================

model Startup {
  id        String   @id @default(cuid())
  ideaId    String   @unique
  userId    String

  // Profile Data
  name        String
  slug        String   @unique
  tagline     String?
  description String?  @db.Text
  industry    String?
  stage       StartupStage @default(IDEA)
  targetMarket TargetMarket?

  // Branding
  logoUrl  String?
  website  String?
  location String?

  // Launch Status
  isLaunched    Boolean   @default(false)
  launchDate    DateTime?
  weeksToLaunch Int?

  // Primary Metric
  primaryMetricType   PrimaryMetricType @default(USER_CONVERSATIONS)
  primaryMetricValue  Float?
  primaryMetricTarget Float?

  // Weekly Tracking
  currentWeekNumber Int       @default(1)
  lastUpdateAt      DateTime?

  // Status
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  idea          Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyUpdates WeeklyUpdate[]
  metrics       StartupMetric[]
  goals         StartupGoal[]
  opportunities StartupOpportunity[]
  cohortStartups CohortStartup[]
  acceleratorApplications AcceleratorApplication[]
  streak         StartupStreak?
  taskLists      TaskList[]
  tasks          Task[]
  members       StartupMember[]
  followers     StartupFollower[]
  conversations StartupConversation[]
  researchFeedItems ResearchFeedItem[]

  @@index([userId])
  @@index([slug])
  @@map("startups")
}

model StartupConversation {
  id        String         @id @default(cuid())
  startupId String
  title     String?
  isActive  Boolean        @default(true)
  messageCount Int         @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages  StartupMessage[]
  startup   Startup        @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@index([isActive])
  @@map("startup_conversations")
}

model StartupMessage {
  id             String            @id @default(cuid())
  conversationId String
  role           String            // user, assistant, system
  content        String            @db.Text
  toolCalls      Json?
  toolResults    Json?
  tokensUsed     Int?
  createdAt      DateTime          @default(now())

  conversation   StartupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("startup_messages")
}

model StartupFollower {
  id        String   @id @default(cuid())
  startupId String
  email     String
  name      String?
  createdAt DateTime @default(now())
  createdBy String?

  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([startupId, email])
  @@index([startupId])
  @@index([email])
  @@map("startup_followers")
}

model StartupMember {
  id        String           @id @default(cuid())
  startupId String
  userId    String
  role      StartupMemberRole @default(MEMBER)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  startup   Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([startupId, userId])
  @@index([startupId])
  @@index([userId])
  @@map("startup_members")
}

model WeeklyUpdate {
  id        String   @id @default(cuid())
  startupId String
  weekNumber Int
  weekStart  DateTime
  weekEnd    DateTime

  // Launch Section
  isLaunched    Boolean @default(false)
  weeksToLaunch Int?

  // User Conversations
  usersTalkedTo Int     @default(0)
  userLearnings String? @db.Text

  // Primary Metric
  primaryMetricType  PrimaryMetricType @default(USER_CONVERSATIONS)
  primaryMetricValue Float
  primaryMetricDelta Float?
  metricPeriod       MetricPeriod?
  metricFormat       MetricFormat?
  customMetricName   String?

  // Additional Metrics (expandable section)
  additionalMetrics Json?

  // Goals Review
  previousGoalsReview Json?
  goalsCompletionRate Float?

  // Goals & Morale
  moraleScore     Int     // 1-10
  topImprovements String? @db.Text
  biggestObstacle String? @db.Text

  // AI Coaching
  aiAnalysis        Json?
  aiVerdict         String?
  aiRecommendations Json?

  // Editability
  editableUntil DateTime?  // Can be edited until this time (createdAt + 3 days)
  isLocked      Boolean   @default(false)
  lockedAt      DateTime?

  createdAt DateTime @default(now())

  startup       Startup              @relation(fields: [startupId], references: [id], onDelete: Cascade)
  goals         WeeklyGoal[]
  metricHistory WeeklyMetricEntry[]

  @@unique([startupId, weekNumber])
  @@index([startupId])
  @@index([weekStart])
  @@map("weekly_updates")
}

model WeeklyGoal {
  id              String @id @default(cuid())
  weeklyUpdateId  String
  content         String
  priority        Int    @default(1)
  completed       Boolean @default(false)

  weeklyUpdate WeeklyUpdate @relation(fields: [weeklyUpdateId], references: [id], onDelete: Cascade)

  @@index([weeklyUpdateId])
  @@map("weekly_goals")
}

model WeeklyMetricEntry {
  id             String            @id @default(cuid())
  weeklyUpdateId String
  metricType     PrimaryMetricType
  value          Float

  weeklyUpdate WeeklyUpdate @relation(fields: [weeklyUpdateId], references: [id], onDelete: Cascade)

  @@index([weeklyUpdateId])
  @@map("weekly_metric_entries")
}

model StartupMetric {
  id        String   @id @default(cuid())
  startupId String
  name      String
  value     Float
  target    Float?
  updatedAt DateTime @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([startupId, name])
  @@map("startup_metrics")
}

model StartupGoal {
  id        String    @id @default(cuid())
  startupId String
  content   String
  completed Boolean   @default(false)
  dueDate   DateTime?
  priority  Int       @default(0)  // 1=Top Priority, 2=Secondary, 3=Third, 0=Normal
  createdAt DateTime  @default(now())

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@index([priority])
  @@map("startup_goals")
}

model StartupStreak {
  id              String    @id @default(cuid())
  startupId       String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastUpdateWeek  DateTime?
  streakStartDate DateTime?
  updatedAt       DateTime  @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@map("startup_streaks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model TaskList {
  id        String   @id @default(cuid())
  startupId String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([startupId])
  @@index([position])
  @@map("task_lists")
}

model Task {
  id          String     @id @default(cuid())
  startupId   String
  listId      String
  title       String
  description String?    @db.Text
  deadline    DateTime?
  status      TaskStatus @default(TODO)
  position    Int        @default(0)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  startup Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  list   TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@index([listId])
  @@index([status])
  @@index([deadline])
  @@index([position])
  @@map("tasks")
}

enum StartupStage {
  IDEA
  VALIDATION
  BUILDING
  LAUNCHED
  SCALING
}

enum TargetMarket {
  CONSUMER
  SMB
  ENTERPRISE
}

enum PrimaryMetricType {
  // Revenue & Financial
  MRR
  ARR
  GROSS_REVENUE
  NET_REVENUE
  TAKE_RATE
  SOFTWARE_SALES
  HARDWARE_SALES
  PREORDER_SALES
  LETTERS_OF_INTENT
  PAID_TRIALS
  PAID_CONTRACTS
  ECOMMERCE_SALES
  MARKETPLACE_VOLUME
  TRANSACTION_VOLUME
  ASSETS_UNDER_MANAGEMENT

  // User & Engagement
  DAU
  WAU
  MAU
  PAYING_CUSTOMERS
  NEW_SIGNUPS
  RETENTION_RATE
  CHURN_RATE

  // Marketplace & Transactions
  GMV
  COMPLETED_ORDERS
  BOOKINGS
  UNITS_SOLD

  // Growth & Trajectory
  WEEK_OVER_WEEK_GROWTH
  MONTH_OVER_MONTH_GROWTH

  // Special Cases
  SIGNED_CONTRACTS
  PIPELINE_VALUE
  PRODUCT_MILESTONES
  USER_CONVERSATIONS
  WAITLIST_SIGNUPS

  // Custom
  CUSTOM
}

enum MetricPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MetricFormat {
  CURRENCY
  PERCENTAGE
  NUMBER
}

// ===========================================
// Startup Opportunities
// ===========================================

enum OpportunityCategory {
  FELLOWSHIP
  SCHOLARSHIP
  FUNDING
  COMPETITION
  ACCELERATOR
  GRANT
  MENTORSHIP
  OTHER
}

enum OpportunityStatus {
  DISCOVERED
  BOOKMARKED
  TO_APPLY
  APPLIED
  INTERVIEWING
  ACCEPTED
  REJECTED
}

model StartupOpportunity {
  id            String   @id @default(cuid())
  startupId     String
  title         String
  description   String   @db.Text
  url           String
  category      OpportunityCategory
  eligibility   String?  @db.Text
  benefits      String?  @db.Text
  deadline      DateTime?
  
  // Tracking
  status        OpportunityStatus @default(DISCOVERED)
  appliedAt     DateTime?
  notes         String?  @db.Text
  
  // Source
  source        String   @default("manual") // manual, ai_generated
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  startup       Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  
  @@index([startupId])
  @@index([status])
  @@index([category])
  @@map("startup_opportunities")
}

// ===========================================
// Accelerator Program
// ===========================================

model Accelerator {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  
  // Description
  description   String?  @db.Text
  programType   String   @default("accelerator") // incubator, accelerator, cohort_based
  
  // Branding
  logoUrl       String?
  website       String?
  contactEmail  String?
  
  // Program Details
  durationWeeks Int?
  benefits      String?  @db.Text
  requirements  String?  @db.Text
  maxStartups  Int?
  fundingAmount String?
  
  // Visibility
  isPublic     Boolean  @default(true)
  isActive     Boolean  @default(true)
  
  // Owner
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cohorts       Cohort[]
  events        AcceleratorEvent[]
  applications  AcceleratorApplication[]
  
  @@index([slug])
  @@index([ownerId])
  @@index([isPublic])
  @@map("accelerators")
}

model Cohort {
  id              String   @id @default(cuid())
  acceleratorId   String
  name            String   // "Winter 2026"
  description     String?
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  
  accelerator     Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)
  startups        CohortStartup[]
  events          AcceleratorEvent[]
  
  @@index([acceleratorId])
  @@map("cohorts")
}

model CohortStartup {
  cohortId      String
  startupId     String
  joinedAt      DateTime @default(now())
  
  cohort        Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  startup       Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  
  @@id([cohortId, startupId])
  @@index([startupId])
  @@map("cohort_startups")
}

model AcceleratorEvent {
  id            String   @id @default(cuid())
  cohortId      String?
  acceleratorId String
  
  title         String
  description   String?  @db.Text
  eventType     String   // mentor_session, office_hours, demo_day, workshop, networking
  scheduledAt   DateTime
  duration      Int      // minutes
  location      String?  // physical, virtual, hybrid
  meetingUrl    String?
  
  cohort        Cohort?   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  accelerator   Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)
  
  @@index([acceleratorId])
  @@index([cohortId])
  @@index([scheduledAt])
  @@map("accelerator_events")
}

model AcceleratorApplication {
  id            String   @id @default(cuid())
  acceleratorId String
  startupId     String?
  founderEmail  String
  founderName   String
  founderPhone  String?
  
  // Application
  status        String   @default("pending") // pending, accepted, waitlisted, rejected
  notes         String?  @db.Text
  answers       Json?    // Custom application answers
  
  // Timestamps
  appliedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  accelerator   Accelerator @relation(fields: [acceleratorId], references: [id], onDelete: Cascade)
  startup       Startup?    @relation(fields: [startupId], references: [id], onDelete: Cascade)
  
  @@index([acceleratorId])
  @@index([startupId])
  @@map("accelerator_applications")
}

// ===========================================
// Research Feed
// ===========================================

enum ResearchFeedType {
  IDEA_RESEARCH
  WEEKLY_REPORT
  WEEKLY_DIGEST
  WEEKLY_REMINDER
}

model ResearchFeedItem {
  id        String           @id @default(cuid())
  startupId String
  ideaId    String?
  type      ResearchFeedType
  title     String
  summary   String?          @db.Text
  content   Json?            // For type-specific data
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  idea    Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([startupId])
  @@index([type])
  @@index([createdAt])
  @@map("research_feed_items")
}
