// ===========================================
// Research Feed
// ===========================================

enum ResearchFeedType {
  IDEA_RESEARCH
  WEEKLY_REPORT
  WEEKLY_DIGEST
  WEEKLY_REMINDER
}

model ResearchFeedItem {
  id             String           @id @default(cuid())
  startupId      String
  ideaId         String?
  type           ResearchFeedType
  title          String
  summary        String?          @db.Text
  content        Json? // For type-specific data
  idempotencyKey String?          @unique // To prevent duplicate entries during retries
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  startup Startup @relation(fields: [startupId], references: [id], onDelete: Cascade)
  idea    Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([startupId])
  @@index([type])
