// IdeasVault Prisma Schema
// AI-powered idea vault for founders

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===========================================
// Authentication (Better Auth)
// ===========================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  username      String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Email Verification
  verificationCode   String?
  verificationExpiry DateTime?
  accountStatus      AccountStatus @default(ACTIVE)

  // Password Reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // Preferences
  emailNotifications Boolean @default(true)

  role UserRole @default(USER)

  // Relations
  sessions     Session[]
  accounts     Account[]
  ideas        Idea[]
  entitlements Entitlement[]
  auditLogs    AuditLog[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  FROZEN
  DELETED
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===========================================
// Core Business Logic
// ===========================================

model Idea {
  id           String     @id @default(cuid())
  userId       String
  title        String?
  summary      String?
  status       IdeaStatus @default(PENDING)
  isArchived   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  researchedAt DateTime?

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputs          IdeaInput[]
  researchJobs    ResearchJob[]
  researchPackets ResearchPacket[]
  scores          IdeaScore[]
  researchLogs    ResearchLog[]
  snapshots       IdeaSnapshot[]

  // Interrogation State
  founderGoals String[] @default([])
  assumptions  Json? // Array of assumption objects
  metrics      Json? // Quantitative metrics (MAU, CAC, LTV, etc.)
  state        Json? // Full state snapshot for delta detection

  // Location Targeting
  targetLocation  String? // User-specified location (e.g., "United States", "California")
  locationContext Json?   // Structured location data: { country, region, city, timezone }

  // URL Handling
  extractedUrls String[] @default([]) // URLs found in user input
  urlContents   UrlContent[]          // Scraped content from URLs

  // Prompt Tracking & Contextualization
  originalPrompt    String? @db.Text // What user actually submitted
  interpretedPrompt String? @db.Text // AI's interpretation/enhancement
  promptVersions    PromptVersion[]  // Track prompt edits

  // AI Guide
  guideConversations GuideConversation[]

  @@index([userId])
  @@index([status])
  @@index([targetLocation])
  @@map("ideas")
}

model IdeaSnapshot {
  id      String   @id @default(cuid())
  ideaId  String
  date    DateTime @default(now())
  state   Json // Full state JSON as per spec
  verdict Json // Verdict JSON (Go/Pause/Kill, etc.)
  deltas  Json? // Detected changes since last snapshot

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_snapshots")
}

enum IdeaStatus {
  PENDING // Just submitted, not yet processed
  PROCESSING // AI pipeline running
  RESEARCHED // Research complete
  FAILED // Pipeline failed
}

model IdeaInput {
  id       String        @id @default(cuid())
  ideaId   String
  type     IdeaInputType
  content  String? // Text content
  fileUrl  String? // URL to uploaded file
  fileName String?
  mimeType String?
  fileSize Int?

  // Processed content
  transcription String? // For audio inputs
  ocrText       String? // For image inputs

  // URL Handling
  extractedUrls String[] @default([]) // URLs found in this specific input

  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_inputs")
}

enum IdeaInputType {
  TEXT
  AUDIO
  IMAGE
}

// ===========================================
// AI Research Pipeline
// ===========================================

model ResearchJob {
  id           String            @id @default(cuid())
  ideaId       String
  status       ResearchJobStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  error        String?
  retryCount   Int               @default(0)
  inngestRunId String? // Track Inngest run ID
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([status])
  @@map("research_jobs")
}

enum ResearchJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ResearchPacket {
  id         String            @id @default(cuid())
  ideaId     String
  agentType  ResearchAgentType
  content    Json // Structured agent output
  confidence Float? // 0-1 confidence score
  version    Int               @default(1)
  createdAt  DateTime          @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([agentType])
  @@map("research_packets")
}

enum ResearchAgentType {
  INTERPRETER
  MARKET_RESEARCH
  TREND_ANALYSIS
  EXECUTION_FRICTION
  SYNTHESIS
  DEEP_RESEARCH
  STRATEGIC_ADVISORY
}

model IdeaScore {
  id     String @id @default(cuid())
  ideaId String

  // Individual scores (0-100)
  clarityScore   Int?
  marketScore    Int?
  executionScore Int?
  overallScore   Int?

  // Explanations
  clarityExplanation   String?
  marketExplanation    String?
  executionExplanation String?
  overallExplanation   String?

  version   Int      @default(1)
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_scores")
}

model ResearchLog {
  id         String            @id @default(cuid())
  ideaId     String
  agentType  ResearchAgentType
  promptHash String // Hash for deduplication
  prompt     String // Full prompt sent
  response   String // Raw response received
  model      String // AI model used
  tokensUsed Int?
  latencyMs  Int?
  createdAt  DateTime          @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([agentType])
  @@map("research_logs")
}

// ===========================================
// Billing (Polar)
// ===========================================

model Entitlement {
  id                  String            @id @default(cuid())
  userId              String
  polarCustomerId     String?
  polarSubscriptionId String?
  plan                EntitlementPlan   @default(FREE)
  maxActiveIdeas      Int               @default(3)
  status              EntitlementStatus @default(ACTIVE)
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([polarCustomerId])
  @@index([polarSubscriptionId])
  @@map("entitlements")
}

enum EntitlementPlan {
  FREE
  PRO
}

enum EntitlementStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
}

// ===========================================
// Audit & Security
// ===========================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // e.g., "idea.created", "research.completed"
  resource   String? // e.g., "idea", "research_job"
  resourceId String?
  metadata   Json? // Additional context
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===========================================
// URL Scraping
// ===========================================

model UrlContent {
  id          String   @id @default(cuid())
  ideaId      String
  url         String
  title       String?
  description String?
  content     String   @db.Text // Scraped text content
  metadata    Json?    // Headers, timestamps, contentType, etc.
  status      UrlContentStatus @default(PENDING) // PENDING, SCRAPED, FAILED
  error       String?  // Error message if scraping failed
  scrapedAt   DateTime? // When scraping completed
  createdAt   DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([url])
  @@map("url_contents")
}

enum UrlContentStatus {
  PENDING
  SCRAPED
  FAILED
}

// ===========================================
// Prompt Tracking & Versioning
// ===========================================

model PromptVersion {
  id                String   @id @default(cuid())
  ideaId            String
  prompt            String   @db.Text // The prompt text at this version
  editedAt          DateTime @default(now())
  triggeredResearch Boolean  @default(false) // Whether this edit triggered new research
  editedBy          String?  // User ID if available

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([editedAt])
  @@map("prompt_versions")
}

// ===========================================
// AI Guide - Conversational Deep Dive
// ===========================================

model GuideConversation {
  id        String         @id @default(cuid())
  ideaId    String
  title     String?        // Optional title for the conversation
  isActive  Boolean        @default(true) // Soft delete support
  messageCount Int        @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages GuideMessage[]
  idea     Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([isActive])
  @@map("guide_conversations")
}

model GuideMessage {
  id             String            @id @default(cuid())
  conversationId String
  role           GuideMessageRole
  content        String            @db.Text
  toolCalls      Json?             // Any tool calls made by AI (search, etc.)
  toolResults    Json?             // Results from tool calls
  tokensUsed     Int?              // Token count for this message
  createdAt      DateTime          @default(now())

  conversation GuideConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("guide_messages")
}

enum GuideMessageRole {
  USER
  ASSISTANT
  SYSTEM
}
