}

model GrowthCampaignPersona {
  campaignId String
  personaId  String
  campaign   GrowthCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  persona    CustomerPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@id([campaignId, personaId])
  @@index([personaId])
  @@map("growth_campaign_personas")
}

model GrowthExperimentPersona {
  experimentId String
  personaId    String
  experiment   GrowthExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
