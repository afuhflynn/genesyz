# ===========================================
# Genesyz Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Database
# ===========================================
DATABASE_URL="postgresql://genesyz:genesyz@localhost:5446/genesyz?schema=public"

# ===========================================
# Application
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Note: NODE_ENV is set automatically by Next.js; only override if needed
# NODE_ENV="development"

# ===========================================
# Better Auth
# ===========================================
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
# Setup Guide: https://console.cloud.google.com/apis/credentials
# 1. Create a new project in Google Cloud Console
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# AI - OpenRouter
# ===========================================
# Get your API key from: https://openrouter.ai/keys
# OpenRouter provides access to many models with failover.
# If not set, falls back to Google Gemini directly.
OPENROUTER_API_KEY=""

# ===========================================
# AI - Google Gemini
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
# Used as a fallback when OpenRouter models are unavailable.
GOOGLE_GENERATIVE_AI_API_KEY=""

# ==========================================
# AI - Mistral
# ==========================================
# Get your API Key from: https://admin.mistral.ai/organization - (API key tab)
MISTRAL_API_KEY=""

# Get your API key from: https://tavily.com/
TAVILY_API_KEY=""

# ===========================================
# Vector Search - Pinecone
# ===========================================
# Get credentials from: https://app.pinecone.io/
PINECONE_API_KEY=""
PINECONE_INDEX="genesyz-pinecone-index"
PINECONE_ENVIRONMENT=""

# ===========================================
# Storage - UploadThing
# ===========================================
# Setup Guide: https://uploadthing.com/dashboard
# 1. Create a new project
# 2. Get your API key from the dashboard
UPLOADTHING_TOKEN=''

# ===========================================
# Email - Gmail SMTP
# ===========================================
# Setup Guide: https://support.google.com/accounts/answer/185833
# 1. Enable 2-Step Verification on your Google account
# 2. Generate an App Password for "Mail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Genesyz <noreply@genesyz.ai>"

# ===========================================
# Background Jobs - Inngest
# ===========================================
# Get keys from: https://app.inngest.com/
INNGEST_EVENT_KEY="dev-event-key"
INNGEST_SIGNING_KEY="dev-signing-key"

# ===========================================
# Security - Arcjet
# ===========================================
# Get key from: https://app.arcjet.com
ARCJET_KEY=""

# ===========================================
# Billing - Polar
# ===========================================
# Setup Guide: https://docs.polar.sh/
# 1. Create account at https://polar.sh
# 2. Create organization
# 3. Create products for Free and Pro plans
# 4. Get API key from settings
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_ORGANIZATION_ID=""
NEXT_PUBLIC_POLAR_FREE_PRODUCT_ID=""
NEXT_PUBLIC_POLAR_PRO_PRODUCT_ID=""
NEXT_PUBLIC_POLAR_FOUNDER_PRODUCT_ID=""
NEXT_PUBLIC_POLAR_TEAM_PRODUCT_ID=""
NEXT_PUBLIC_POLAR_GROWTH_PRODUCT_ID=""
NEXT_PUBLIC_POLAR_ACCELERATOR_PRODUCT_ID=""
NEXT_PUBLIC_POLAR_ENTERPRISE_PRODUCT_ID=""

# ===========================================
# App
# ===========================================
NEXT_PUBLIC_APP_NAME="Genesyz"
